# ====================
# BANCO DE DADOS (fornecido pela Locaweb após criar o banco)
# ====================
DATABASE_URL=postgresql://usuario:senha@pgsql.locaweb.com.br:5432/nome_banco
SQLALCHEMY_DATABASE_URI=postgresql://usuario:senha@pgsql.locaweb.com.br:5432/nome_banco

# ====================
# FLASK
# ====================
FLASK_APP=CRM.py
FLASK_ENV=production

# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERAR_UMA_CHAVE_SECRETA_ALEATORIA_MUITO_LONGA_AQUI

# ====================
# SEGURANÇA
# ====================
WTF_CSRF_ENABLED=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ====================
# UPLOAD DE ARQUIVOS
# ====================
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=/home/seu_usuario_locaweb/public_html/static/uploads

# ====================
# EMAIL (opcional - configurar se usar recuperação de senha)
# ====================
MAIL_SERVER=smtp.locaweb.com.br
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu_email@seudominio.com.br
MAIL_PASSWORD=sua_senha_email
MAIL_DEFAULT_SENDER=seu_email@seudominio.com.br

# ====================
# LOGS
# ====================
LOG_LEVEL=INFO
LOG_FILE=/home/seu_usuario_locaweb/public_html/logs/crm.log

# ====================
# DOMÍNIO (usado para gerar URLs de arquivos para Z-API)
# ====================
DOMAIN=https://crm.seudominio.com.br

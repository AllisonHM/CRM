# =============================================
# 🔐 VARIÁVEIS DE AMBIENTE
# =============================================
#
# Criar este arquivo na raiz do projeto: .env
# NÃO COMITAR ESTE ARQUIVO NO GIT!
# Adicionar .env ao .gitignore
#
# =============================================

# API Key para site institucional (gerar chave forte)
# Exemplo de geração: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_SITE=sua-chave-secreta-aqui-123456

# Origens permitidas (separadas por vírgula)
# Em desenvolvimento:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Em produção (adicionar):
# ALLOWED_ORIGINS=https://seu-site.github.io,https://seu-site.netlify.app

# ID do usuário CRM que receberá os leads do site
# Normalmente o ID do admin/super_admin (1 por padrão)
USUARIO_CRM_LEADS=1

# =============================================
# 📧 EMAIL (RECUPERAÇÃO DE SENHA)
# =============================================
# Gmail (recomendado com senha de app)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
